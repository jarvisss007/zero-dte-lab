// ═══════════════════════════════════════════════
// AUTO FIB RETRACEMENT v2.1 — any symbol, scales with the timeframe
// Paste at the very END of the IE Pro script (Pine v6), REPLACING the v1 block.
// DISPLAY ONLY: it changes no entry, no exit and no Strategy Tester number.
//
// v2 (2026-09-19): v1 anchored on the window's absolute high and low. On HWM daily that picked the
// SPRING low (220.51) and the August high (310) and read the chart as an up-swing that had given
// back 90% - so 0 sat on top and the target line sat up at 334. "Latest leg" anchors instead on the
// most recent extreme and the furthest price SINCE it: for HWM, 310 down to 223, with the bounce
// levels above price and the targets below it. "Whole window" keeps the v1 behaviour.
// ═══════════════════════════════════════════════
i_fib_on   = input.bool(true, "Show auto Fib",                                  group="Auto Fib")
i_fib_mode = input.string("Latest leg", "Anchor on", options=["Latest leg", "Whole window"], group="Auto Fib")
i_fib_len  = input.int(0,     "Swing lookback in bars (0 = auto by timeframe)", group="Auto Fib", minval=0)
i_fib_minr = input.bool(true, "Show 0.236 and 0.786",                           group="Auto Fib")
i_fib_ext  = input.bool(true, "Show targets (-0.272 / -0.618)",                 group="Auto Fib")
i_fib_zone = input.bool(true, "Shade the 0.5 - 0.618 zone",                     group="Auto Fib")
i_fib_xr   = input.bool(true, "Extend lines right",                             group="Auto Fib")

fib_auto_len() =>
    int s = timeframe.in_seconds()
    s <= 60 ? 240 : s <= 300 ? 156 : s <= 900 ? 130 : s <= 14400 ? 120 : s <= 86400 ? 126 : s <= 604800 ? 52 : 36

fib_want = math.min(480, i_fib_len > 0 ? i_fib_len : fib_auto_len())
fib_len  = math.max(2, math.min(fib_want, bar_index + 1))

// the window's two extremes, and which of them is the more recent
w_hi     = ta.highest(high, fib_len)
w_lo     = ta.lowest(low, fib_len)
w_hi_off = ta.highestbars(high, fib_len)
w_lo_off = ta.lowestbars(low, fib_len)
hi_recent = w_hi_off > w_lo_off

// the furthest price reached SINCE that more recent extreme (all four computed every bar)
// v2.1: on the first bars the offsets are na, and an na LENGTH is a runtime error that halts the
// script (the red "!" on the chart) - nz() guards it. max_bars_back sizes the buffers a varying
// length needs.
max_bars_back(high, 500)
max_bars_back(low, 500)
int fib_back = hi_recent ? -w_hi_off : -w_lo_off
fib_since  = math.max(1, nz(fib_back, 0) + 1)
leg_lo     = ta.lowest(low, fib_since)
leg_lo_off = ta.lowestbars(low, fib_since)
leg_hi     = ta.highest(high, fib_since)
leg_hi_off = ta.highestbars(high, fib_since)

leg_size = hi_recent ? w_hi - leg_lo : leg_hi - w_lo
leg_ok   = i_fib_mode == "Latest leg" and fib_since > 1 and leg_size >= 0.15 * (w_hi - w_lo)

// level 1 = where the swing STARTED, level 0 = where it ENDED; targets extend past the end
f_start   = leg_ok ? (hi_recent ? w_hi : w_lo)       : (hi_recent ? w_lo : w_hi)
f_end     = leg_ok ? (hi_recent ? leg_lo : leg_hi)   : (hi_recent ? w_hi : w_lo)
off_start = leg_ok ? (hi_recent ? w_hi_off : w_lo_off) : (hi_recent ? w_lo_off : w_hi_off)

// Hook for later — NOT wired into any signal. True while price sits in the 0.382-0.618 zone.
fib_z382    = f_end + 0.382 * (f_start - f_end)
fib_z618    = f_end + 0.618 * (f_start - f_end)
in_fib_zone = close <= math.max(fib_z382, fib_z618) and close >= math.min(fib_z382, fib_z618)

var float[]  fib_lv   = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, -0.272, -0.618)
var line[]   fib_ln   = array.new<line>()
var label[]  fib_lb   = array.new<label>()
var linefill fib_fill = na

if i_fib_on and barstate.islast and not na(f_start) and not na(f_end) and f_start != f_end
    int x1 = bar_index + off_start

    if array.size(fib_ln) == 0
        for i = 0 to array.size(fib_lv) - 1
            array.push(fib_ln, line.new(x1, f_end, bar_index, f_end, xloc=xloc.bar_index, width=1))
            array.push(fib_lb, label.new(bar_index, f_end, "", style=label.style_label_left, color=color.new(color.black, 100), size=size.small))

    for i = 0 to array.size(fib_lv) - 1
        float r       = array.get(fib_lv, i)
        bool  isMinor = i == 1 or i == 5
        bool  isKey   = i == 3 or i == 4
        bool  isExt   = i >= 7
        bool  isEnd   = i == 0 or i == 6
        bool  show    = (not isMinor or i_fib_minr) and (not isExt or i_fib_ext)
        float px      = f_end + r * (f_start - f_end)
        color base    = isKey ? c_amber : isExt ? c_long : isEnd ? c_neut : c_ema_s
        color col     = show ? base : color.new(base, 100)
        line  ln      = array.get(fib_ln, i)
        label lb      = array.get(fib_lb, i)
        line.set_xy1(ln, x1, px)
        line.set_xy2(ln, bar_index, px)
        line.set_extend(ln, i_fib_xr ? extend.right : extend.none)
        line.set_color(ln, col)
        line.set_style(ln, isKey or isEnd ? line.style_solid : line.style_dashed)
        label.set_xy(lb, bar_index + 3, px)
        label.set_text(lb, show ? str.tostring(r, "0.###") + "   " + str.tostring(px, format.mintick) : "")
        label.set_textcolor(lb, col)

    if i_fib_zone and na(fib_fill)
        fib_fill := linefill.new(array.get(fib_ln, 3), array.get(fib_ln, 4), color.new(c_amber, 88))
